# Postgres — local docker-compose default; in production use your Neon connection string
# (e.g. postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require)
DATABASE_URL=postgresql://ecomess:ecomess_password@localhost:5432/ecomess_db

NODE_ENV=development
PORT=5000

# Comma-separated allowed frontend origins (your Vercel URL in production)
FRONTEND_URL=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
REFRESH_SECRET=change-me-too

ML_SERVICE_URL=http://localhost:8000
# Must match ML_API_KEY on the ML service (leave empty locally to disable)
ML_API_KEY=

# Seed demo data + demo@ecomess.ai account on first deploy (true/false)
SEED_DEMO=true
